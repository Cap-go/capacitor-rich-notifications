<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required because this library posts notifications. Exact alarms, full-screen
         intents, and the foreground service stay opt-in in the host app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".ActionReceiver"
            android:exported="false" />
        <activity
            android:name=".FullScreenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true"
            android:theme="@style/Theme.Capgo.RichNotifications.Translucent"
            android:turnScreenOn="true" />
    </application>
</manifest>
